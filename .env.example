# Host port. Inside the container the API always listens on 8004.
PORT=8004

# Multilingual checkpoint. v3 is the quality default (t3_mtl23ls_v3).
# v2 is the older multilingual checkpoint, only if you need to compare.
CHATTERBOX_T3_MODEL=v3

# Used when a request omits "language". de or pl.
TTS_LANGUAGE=de

# Optional. The model repo is public; leave empty.
HF_TOKEN=

# Sentence-ish chunk size. The model caps each call at 1000 speech tokens
# (~40 s). Long articles are split so they are not truncated.
TTS_CHUNK_CHARS=400
